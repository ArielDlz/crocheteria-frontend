# Configuración de line endings para Git
# https://git-scm.com/docs/gitattributes

# Archivos de texto - normalizar a LF en el repositorio
* text=auto eol=lf

# Archivos que siempre deben usar LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Archivos binarios - no tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Archivos de configuración específicos
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

