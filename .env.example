# Variables de entorno para Crochetería Frontend
# Copia este archivo a .env.local y ajusta los valores según tu entorno

# URL base del API backend
# Desarrollo local: http://localhost:3000/api
# Producción: https://api.crocheteria.mx/api
VITE_API_BASE_URL=http://localhost:3000/api

# Nombre de la aplicación
VITE_APP_NAME=Crochetería
